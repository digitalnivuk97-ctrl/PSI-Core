CONVEX_BACKEND_IMAGE=ghcr.io/get-convex/convex-backend@sha256:REPLACE_WITH_RELEASE_DIGEST
CONVEX_DASHBOARD_IMAGE=ghcr.io/get-convex/convex-dashboard@sha256:REPLACE_WITH_RELEASE_DIGEST
CONVEX_SELF_HOSTED_MODE=local
NEXT_PUBLIC_CONVEX_URL=https://convex.example.test
CONVEX_SELF_HOSTED_URL=http://backend:3210
CONVEX_INTERNAL_KEY=replace-with-a-long-random-internal-sync-key
CONVEX_BIND_ADDRESS=127.0.0.1
CONVEX_BACKEND_PORT=3210
PORTABLE_CORE_REQUIRE_CONVEX=true
PORTABLE_CORE_SETUP_TOKEN=replace-with-a-long-random-setup-token
PORTABLE_CORE_REQUIRE_HTTPS=false
COOKIE_SECURE=true
INSTANCE_NAME=portable-core
INSTANCE_SECRET=replace-with-generated-instance-secret
PORTABLE_CORE_PORT=8080
